# firms-client settings. Copy to .env (never committed) and fill in:
#   cp .env.example .env
# The library and the `firms` command read DATA_ROOT and FIRMS_MAP_KEY
# from the environment, else from the .env of the current directory.
# Values with spaces go between quotes.

# --- Data directory --------------------------------------------------------
# The data root shared by the agent-engineering-studio libraries: each one
# keeps its files in its own folder under it, this one in
# $DATA_ROOT/firms-client. Every download goes there and is read from there:
# yearly country archives, the static-source mask, WorldCover (firms init,
# firms sync) and sync.json. A relative path is relative to the directory
# you run from. Unset: ~/.cache/firms-client. (FIRMS_DATA_DIR, if set,
# still overrides it, for compatibility.)
DATA_ROOT=./data

# --- NASA FIRMS MAP_KEY ----------------------------------------------------
# Free, needed only for the near-real-time area API (`firms area`,
# `firms status`, the area tools of the MCP server); the yearly archives
# need no key. 32 lowercase letters and digits, 5,000 transactions per
# 10 minutes. Ask for one with your e-mail at
#   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Treat it as a password: never in the code or in a repository.
FIRMS_MAP_KEY=

# --- MCP server (extra firms-client[mcp]) ----------------------------------
# Where `export_geojson` may write. Unset: <data directory>/exports.
# FIRMS_EXPORT_DIR=./data/exports

# --- Bulletins with Claude (extra firms-client[claude]) ---------------------
# Only for ClaudeWriter: drafts of alert bulletins. Paid API.
# ANTHROPIC_API_KEY=

# --- Docker (docker compose up, make up) -----------------------------------
# In the containers the data live in /data (DATA_ROOT above is for running
# without Docker). They go to the volume firms-data, or to a folder of this
# machine written here (it must be writable by the user of the image, uid 1000).
# FIRMS_DATA_VOLUME=/srv/firms-client
# The MAP_KEY as a file instead of FIRMS_MAP_KEY: the folder mounted read-only
# at /run/secrets/firms, and the name of the file in it (one line, the key).
# The key is never copied into an image.
FIRMS_SECRETS_DIR=./secrets
FIRMS_MAP_KEY_NAME=map_key
# The ports, on 127.0.0.1 only: the page, the notebooks, the MCP server.
FIRMS_UI_PORT=3005
FIRMS_NOTEBOOK_PORT=8890
FIRMS_MCP_PORT=8769
# The token of JupyterLab. Empty: a random one, in `docker compose logs notebook`.
FIRMS_NOTEBOOK_TOKEN=

# --- The page of a Comune (http://127.0.0.1:3005) --------------------------
# The Comune, in decimal degrees: here Palermo, which is also the default.
# The page reads one area around it: the fires of the last days (with a
# MAP_KEY), of every archive year, and how far to trust a detection there.
FIRMS_UI_LAT=38.1157
FIRMS_UI_LON=13.3615
# The radius of the area, in km, 1 to 30 (default 10).
FIRMS_UI_RADIUS_KM=
# The name in the header.
FIRMS_UI_PLACE="Comune di Palermo"
# The country of the archives, as FIRMS writes it (default Italy).
FIRMS_UI_COUNTRY=
# The source of the last days: VIIRS_SNPP_NRT (default), VIIRS_NOAA20_NRT,
# VIIRS_NOAA21_NRT or MODIS_NRT.
FIRMS_UI_NRT_SOURCE=
# 1 (default): download the ESA WorldCover tiles of the area (about 60 MB
# each, once) to say what land burnt and how far to trust a point. 0: no.
FIRMS_UI_LAND_COVER=1
# The zoom the map opens at, 5 to 16 (default: the whole area).
FIRMS_UI_ZOOM=
# The language: it or en (default it). The visitor can switch.
FIRMS_UI_LANG=it
# Who may show the page in an iframe, as a CSP frame-ancestors list, such as
# "https://www.comune.palermo.it". Default: this site only.
FIRMS_UI_FRAME_ANCESTORS=
# The tiles of the background map, and their credit (default: OpenStreetMap,
# which then sees the address of every visitor).
FIRMS_UI_TILES=
FIRMS_UI_TILES_CREDIT=
